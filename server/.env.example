PORT=4000
# Postgres connection string. Render provides this automatically when a
# Postgres instance is linked to this service (see render.yaml) - for local
# dev, point it at any Postgres you have running, e.g.:
# postgres://postgres:postgres@localhost:5432/sms_quest
DATABASE_URL=
# Set to "false" only for a local Postgres with no SSL cert. Leave unset
# (or anything other than "false") against Render's Postgres.
DATABASE_SSL=

# Milestone 173: teacher "forgot password" email, via Resend (https://resend.com). Get
# RESEND_API_KEY from the Resend dashboard - a real secret, set it directly in Render's env
# vars, never commit a real value here. RESEND_FROM_EMAIL must be an address on a domain
# verified in that Resend account (their dashboard walks through the DNS records) - without
# domain verification, Resend only delivers to the account owner's own email, not real teachers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where the emailed reset link points - defaults to the live Render URL if unset, only needed if
# the dashboard is ever served from somewhere else.
PUBLIC_BASE_URL=
