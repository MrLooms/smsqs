PORT=4000
# Postgres connection string. Render provides this automatically when a
# Postgres instance is linked to this service (see render.yaml) - for local
# dev, point it at any Postgres you have running, e.g.:
# postgres://postgres:postgres@localhost:5432/sms_quest
DATABASE_URL=
# Set to "false" only for a local Postgres with no SSL cert. Leave unset
# (or anything other than "false") against Render's Postgres.
DATABASE_SSL=
